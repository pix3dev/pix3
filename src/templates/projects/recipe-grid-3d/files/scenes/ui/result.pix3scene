# Pix3 Scene File (YAML)
# Grid 3D — the RESULT overlay (win/lose), in its own file so the board scene
# opens clean. `main.pix3scene` carries it as a one-line `instance:` reference
# marked `visible: false`, which hides it in the EDITOR only; `user:GridRules`
# reveals it at run time by setting `visible`.
#
# Edit it here, full-screen, in its own tab. To preview it composited over the
# board, tick the eye on `result-overlay` in main.pix3scene — just do not commit
# that tick, or every iteration starts behind an end screen again.
#
# Stable node ids (design/recipe.md is the contract — do not rename these):
#   result-overlay, result-label, retry-button, menu-button
version: 1.0.0
metadata:
  author: Pix3 Template
  description: Result overlay — dim, win/lose headline, RETRY and MENU buttons
root:
  - id: result-overlay
    type: Group2D
    name: Result Overlay
    properties:
      width: 1080
      height: 1920
      initiallyVisible: false
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    children:
      - id: result-dim
        type: ColorRect2D
        name: Result Dim
        properties:
          width: 1080
          height: 1920
          color: "#0b0e14"
          opacity: 0.78
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      - id: result-label
        type: Label2D
        name: Result Label
        properties:
          label: "SHAPE REVEALED"
          labelFontSize: 76
          labelColor: "#3ee6c1"
          labelAlign: center
          transform:
            position: [0, 220]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: center
        children: []
      - id: retry-button
        type: Button2D
        name: Retry Button
        properties:
          width: 420
          height: 130
          label: "RETRY"
          labelFontSize: 52
          labelColor: "#0b0e14"
          backgroundColor: "#3ee6c1"
          hoverColor: "#63f0d3"
          pressedColor: "#2bbfa0"
          transform:
            position: [0, -60]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: center
        children: []
      - id: menu-button
        type: Button2D
        name: Menu Button
        properties:
          width: 420
          height: 110
          label: "MENU"
          labelFontSize: 44
          labelColor: "#f2f2f2"
          backgroundColor: "#1b1f2a"
          hoverColor: "#2a3040"
          pressedColor: "#141821"
          transform:
            position: [0, -220]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: center
        children: []
