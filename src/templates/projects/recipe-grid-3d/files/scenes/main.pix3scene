# Pix3 Scene File (YAML)
# Grid 3D — the carving board. The cubes are NOT authored here: GridBoard builds
# them under `board-anchor` at start, so the board size is a tunable, not a
# hand-edited tree. Everything else (camera, lights, HUD) is authored here; the
# end screen lives in scenes/ui/result.pix3scene and is instanced in hidden
# (`visible: false` = editor only), so this scene opens on the board.
#
# Stable node ids (design/recipe.md is the contract — do not rename these):
#   game-root, main-camera, key-light, fill-light, board-anchor,
#   hud-root, score-label, lives-bar,
#   result-overlay, result-label, retry-button, menu-button (scenes/ui/result.pix3scene)
version: 1.0.0
metadata:
  author: Pix3 Template
  description: Tap-to-carve 3D grid with a hidden core
root:
  - id: game-root
    type: Node3D
    name: Game Root
    properties:
      transform:
        position: [0, 0, 0]
        rotationEuler: [0, 0, 0]
        scale: [1, 1, 1]
    components:
      - id: grid-board
        type: user:GridBoard
        enabled: true
        config:
          boardAnchor: board-anchor
          sizeX: 4
          sizeY: 4
          sizeZ: 4
          cellSize: 0.9
          spacing: 1
          coreCount: 6
          cellColor: "#3ee6c1"
          coreColor: "#ff6b6b"
          revealCores: false
      - id: grid-rules
        type: user:GridRules
        enabled: true
        config:
          startingLives: 3
          timeLimitSec: 0
          resultNode: result-overlay
          resultLabel: result-label
          retryButton: retry-button
          menuButton: menu-button
    children:
      - id: main-camera
        type: Camera3D
        name: Main Camera
        properties:
          projection: perspective
          fov: 50
          near: 0.1
          far: 200
          # Aimed exactly at the origin, where the board centres itself. Solved for the engine's
          # XYZ Euler order (R = Rx·Ry), NOT the yaw-then-pitch YXZ order the numbers would have
          # under a camera rig: pitch = -asin(0.6) = -36.87°, yaw = asin(6/|[6,6,8]|) = 30.96°.
          # Swap the two and the view tilts off target — invisible on a full board (some cube
          # still catches the centre ray) and fatal on a 1x1x1 one, which is why the recipe's
          # Verify section shrinks the board.
          transform:
            position: [6, 6, 8]
            rotationEuler: [-36.87, 30.96, 0]
            scale: [1, 1, 1]
        children: []
      - id: key-light
        type: DirectionalLightNode
        name: Key Light
        properties:
          intensity: 1.1
          color: "#ffffff"
          transform:
            position: [6, 9, 4]
            rotationEuler: [-50, 30, 0]
            scale: [1, 1, 1]
        children: []
      - id: fill-light
        type: HemisphereLightNode
        name: Fill Light
        properties:
          skyColor: "#e9f5ff"
          groundColor: "#717786"
          intensity: 0.7
          transform:
            position: [0, 0, 0]
            rotationEuler: [0, 0, 0]
            scale: [1, 1, 1]
        children: []
      - id: board-anchor
        type: Node3D
        name: Board Anchor
        properties:
          transform:
            position: [0, 0, 0]
            rotationEuler: [0, 0, 0]
            scale: [1, 1, 1]
        children: []

  - id: hud-root
    type: Group2D
    name: HUD Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    components:
      - id: score-hud
        type: user:ScoreHud
        enabled: true
        config:
          sourceNode: game-root
          scoreLabel: score-label
          scoreFormat: "CLEARED {value}"
          timeLabel: ""
          livesBar: lives-bar
    children:
      - id: score-label
        type: Label2D
        name: Score Label
        properties:
          label: "CLEARED 0"
          labelFontSize: 48
          labelColor: "#f2f2f2"
          labelAlign: center
          transform:
            position: [0, 820]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: top
        children: []
      - id: lives-bar
        type: Bar2D
        name: Lives Bar
        properties:
          width: 360
          height: 26
          value: 3
          maxValue: 3
          barColor: "#ff6b6b"
          backBackgroundColor: "#1b1f2a"
          transform:
            position: [0, 740]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: top
        children: []
      # Win/lose screen — authored in scenes/ui/result.pix3scene so this scene
      # opens on the BOARD, not on an end card. `visible: false` hides it in the
      # EDITOR only; `initiallyVisible` (in the overlay file) is what play mode
      # reads, and GridRules reveals it on the win/lose transition. Tick the eye
      # to preview it composited over the board.
      - id: result-overlay
        name: Result Overlay
        instance: res://scenes/ui/result.pix3scene
        properties:
          visible: false
