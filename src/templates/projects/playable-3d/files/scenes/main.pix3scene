# Pix3 Scene File (YAML)
# Playable 3D blank (portrait 1080x1920): 3D gameplay placeholder plus a 2D UI
# layer with a tap-to-start intro overlay, a score/lives/time HUD, and an end
# screen with a CTA button. `hud-root` carries all three components: GameFlow
# (phases), GameRules (score/lives/win-lose) and ScoreHud (display only).
#
# Full-screen UI lives in its own file under scenes/ui/ and is instanced into
# `hud-root` hidden (`visible: false` = editor only; `initiallyVisible` in the
# overlay file is what play mode reads), so opening this scene shows the stage
# rather than a dim or a CTA card:
#   intro-overlay (intro-dim, intro-label)       scenes/ui/intro.pix3scene
#   end-screen (end-dim, end-label, cta-button)  scenes/ui/end-screen.pix3scene
# Instance children keep their ids, so `GameFlow`'s introNode/endNode,
# `GameRules`' resultLabel and every `findNode` still resolve.
version: 1.0.0
metadata:
  author: Pix3 Template
  description: Playable 3D blank with intro overlay and CTA end screen
root:
  - id: game-root
    type: Node3D
    name: Game Root
    properties:
      transform:
        position: [0, 0, 0]
        rotationEuler: [0, 0, 0]
        scale: [1, 1, 1]
    children:
      - id: main-camera
        type: Camera3D
        name: Main Camera
        properties:
          projection: perspective
          fov: 60
          near: 0.1
          far: 1000
          transform:
            position: [0, 3, 8]
            rotationEuler: [-15, 0, 0]
            scale: [1, 1, 1]
        children: []
      - id: key-light
        type: DirectionalLightNode
        name: Key Light
        properties:
          intensity: 1.2
          color: "#ffffff"
          transform:
            position: [5, 8, 3]
            rotationEuler: [-45, 35, 0]
            scale: [1, 1, 1]
        children: []
      - id: ambient-light
        type: AmbientLightNode
        name: Ambient Light
        properties:
          intensity: 0.5
          color: "#ffffff"
          transform:
            position: [0, 0, 0]
            rotationEuler: [0, 0, 0]
            scale: [1, 1, 1]
        children: []
      - id: ground
        type: GeometryMesh
        name: Ground
        properties:
          geometry: box
          size: [12, 0.2, 12]
          material:
            type: lambert
            color: "#2a2a3e"
          transform:
            position: [0, -0.1, 0]
            rotationEuler: [0, 0, 0]
            scale: [1, 1, 1]
        children: []
      - id: hero-box
        type: GeometryMesh
        name: Hero Box
        properties:
          geometry: box
          size: [1, 1, 1]
          material:
            type: lambert
            color: "#ffcf33"
          transform:
            position: [0, 0.5, 0]
            rotationEuler: [0, 45, 0]
            scale: [1, 1, 1]
        components:
          - id: hero-rotate
            type: core:Rotate
            enabled: true
            config: {}
        children: []

  - id: hud-root
    type: Group2D
    name: HUD Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    components:
      - id: game-flow
        type: user:GameFlow
        enabled: true
        config:
          introNode: intro-overlay
          endNode: end-screen
          autoWinAfterSec: 15
          skipIntro: false
      - id: game-rules
        type: user:GameRules
        enabled: true
        config:
          winMode: score
          targetScore: 10
          timeLimitSec: 0
          startingLives: 3
          resultLabel: end-label
          winText: "YOU WIN!"
          loseText: "GAME OVER"
          # The run starts when GameFlow leaves the tap gate, not when the scene loads.
          startWithFlow: true
      - id: score-hud
        type: user:ScoreHud
        enabled: true
        config:
          sourceNode: hud-root
          scoreLabel: score-label
          scoreFormat: "SCORE {value}"
          timeLabel: time-label
          timeFormat: "{value}"
          livesBar: lives-bar
    children:
      - id: hud-label
        type: Label2D
        name: HUD Label
        properties:
          label: "PROTOTYPE"
          labelFontSize: 40
          labelColor: "#ffffff"
          labelAlign: center
          transform:
            position: [0, 780]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: top
        children: []
      - id: score-label
        type: Label2D
        name: Score Label
        properties:
          label: "SCORE 0"
          labelFontSize: 44
          labelColor: "#ffffff"
          labelAlign: left
          transform:
            position: [-340, 880]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: left
            verticalAlign: top
        children: []
      - id: time-label
        type: Label2D
        name: Time Label
        properties:
          label: "0"
          labelFontSize: 44
          labelColor: "#f5ae39"
          labelAlign: center
          transform:
            position: [0, 880]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: top
        children: []
      - id: lives-bar
        type: Bar2D
        name: Lives Bar
        properties:
          width: 240
          height: 28
          minValue: 0
          maxValue: 3
          value: 3
          barColor: "#ff4d6d"
          backBackgroundColor: "#2a3352"
          showBorder: false
          transform:
            position: [340, 885]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: right
            verticalAlign: top
        children: []
      # Tap gate — authored in scenes/ui/intro.pix3scene so this scene opens on
      # the GAME. `visible: false` hides it in the EDITOR only; `initiallyVisible`
      # (in the overlay file) is what play mode reads. Tick the eye to preview it
      # composited over the stage.
      - id: intro-overlay
        name: Intro Overlay
        instance: res://scenes/ui/intro.pix3scene
        properties:
          visible: false
      # End screen — authored in scenes/ui/end-screen.pix3scene so this scene opens
      # on the GAME. `visible: false` hides it in the EDITOR only; `initiallyVisible`
      # (in the overlay file) is what play mode reads. Tick the eye to preview it
      # composited over the stage.
      - id: end-screen
        name: End Screen
        instance: res://scenes/ui/end-screen.pix3scene
        properties:
          visible: false
