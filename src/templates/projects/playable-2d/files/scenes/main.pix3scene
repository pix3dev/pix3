# Pix3 Scene File (YAML)
# Playable 2D blank (portrait 1080x1920): 2D gameplay placeholder plus a
# tap-to-start intro overlay and an end screen with a CTA button.
#
# Full-screen UI lives in its own file under scenes/ui/ and is instanced here
# hidden (`visible: false` = editor only; `initiallyVisible` in the overlay file
# is what play mode reads), so opening this scene shows the game rather than a
# dim or a CTA card:
#   intro-overlay (intro-dim, intro-label)       scenes/ui/intro.pix3scene
#   end-screen (end-dim, end-label, cta-button)  scenes/ui/end-screen.pix3scene
# Instance children keep their ids, so `GameFlow`'s introNode/endNode and every
# `findNode` still resolve. Node order in the tree is paint order.
version: 1.0.0
metadata:
  author: Pix3 Template
  description: Playable 2D blank with intro overlay and CTA end screen
root:
  - id: game-root
    type: Group2D
    name: Game Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    components:
      - id: game-flow
        type: user:GameFlow
        enabled: true
        config:
          introNode: intro-overlay
          endNode: end-screen
          autoWinAfterSec: 15
    children:
      - id: background
        type: ColorRect2D
        name: Background
        properties:
          width: 1080
          height: 1920
          color: "#16213e"
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      - id: hero-sprite
        type: Sprite2D
        name: Hero Sprite
        properties:
          texture: { type: 'texture', url: 'res://sprites/pix3-logo.png' }
          width: 242
          height: 96
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: center
        components:
          - id: hero-bob
            type: core:Sine
            enabled: true
            config:
              amplitude: 40
              frequency: 0.6
              axis: y
        children: []
      - id: hud-label
        type: Label2D
        name: HUD Label
        properties:
          label: "PROTOTYPE"
          labelFontSize: 40
          labelColor: "#ffffff"
          labelAlign: center
          transform:
            position: [0, 860]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: top
        children: []
      # Tap gate — authored in scenes/ui/intro.pix3scene so this scene opens on
      # the GAME. `visible: false` hides it in the EDITOR only; `initiallyVisible`
      # (in the overlay file) is what play mode reads. Tick the eye to preview it
      # composited over the game.
      - id: intro-overlay
        name: Intro Overlay
        instance: res://scenes/ui/intro.pix3scene
        properties:
          visible: false
      # End screen — authored in scenes/ui/end-screen.pix3scene so this scene opens
      # on the GAME. `visible: false` hides it in the EDITOR only; `initiallyVisible`
      # (in the overlay file) is what play mode reads. Tick the eye to preview it
      # composited over the game.
      - id: end-screen
        name: End Screen
        instance: res://scenes/ui/end-screen.pix3scene
        properties:
          visible: false
