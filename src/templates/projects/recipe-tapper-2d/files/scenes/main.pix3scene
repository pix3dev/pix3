# Pix3 Scene File (YAML)
# Tapper 2D — the GAME scene, and the editor's startup scene: iterate here.
# A full build boots the MENU (menu.pix3scene), whose PLAY transitions here.
#
# Objects fall into the board; tapping them is the whole game. A tap is
# hit-tested (scripts/TouchRules.ts) against the `core:Hitbox2D` group each
# prefab carries: `target` scores, `hazard` costs a life.
#
# Stable node ids (design/recipe.md is the contract — do not rename these):
#   game-root, game-background, board, spawner-targets, spawner-hazards,
#   hud, score-label, time-label, lives-bar, menu-button,
#   result-overlay, result-label, retry-button
#
# 2D coordinates: origin at the canvas centre, X right, Y UP. Node order in the
# tree is paint order (later/deeper draws on top).
version: 1.0.0
metadata:
  author: Pix3 Recipe
  description: Tapper gameplay — falling objects, tap the good ones, avoid the bad
root:
  - id: game-root
    type: Group2D
    name: Game Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    components:
      - id: game-rules
        type: user:GameRules
        enabled: true
        config:
          winMode: time
          targetScore: 18
          timeLimitSec: 30
          startingLives: 3
          resultNode: result-overlay
          resultLabel: result-label
          winText: "YOU WIN!"
          loseText: "GAME OVER"
          retryButton: retry-button
          menuButton: menu-button
          menuScene: res://scenes/menu.pix3scene
          gameScene: res://scenes/main.pix3scene
          freezeNodes: spawner-targets,spawner-hazards
      - id: touch-rules
        type: user:TouchRules
        enabled: true
        config:
          rules: "target:score:1;hazard:damage:1"
          tapRadius: 40
          missPenalty: 0
          consume: true
          scoreSound: ""
          damageSound: ""
    children:
      - id: game-background
        type: ColorRect2D
        name: Game Background
        properties:
          width: 1080
          height: 1920
          color: "#141a2e"
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      - id: board
        type: Group2D
        name: Board
        properties:
          width: 980
          height: 1480
          transform:
            position: [0, -80]
            scale: [1, 1]
            rotation: 0
        children:
          - id: board-floor
            type: ColorRect2D
            name: Board Floor
            properties:
              width: 980
              height: 1480
              color: "#1d2743"
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: spawner-targets
            type: Group2D
            name: Spawner Targets
            properties:
              width: 900
              height: 60
              transform:
                position: [0, 690]
                scale: [1, 1]
                rotation: 0
            components:
              - id: target-spawner
                type: user:Spawner
                enabled: true
                config:
                  prefab: res://scenes/prefabs/target.pix3scene
                  parentNode: ""
                  intervalSec: 0.85
                  intervalJitter: 0.3
                  maxAlive: 8
                  spawnWidth: 820
                  spawnHeight: 60
                  gridSnap: 0
                  driftX: 0
                  driftY: -230
                  lifetimeSec: 8
                  despawnRadius: 1450
                  startDelaySec: 0.3
            children: []
          - id: spawner-hazards
            type: Group2D
            name: Spawner Hazards
            properties:
              width: 900
              height: 60
              transform:
                position: [0, 690]
                scale: [1, 1]
                rotation: 0
            components:
              - id: hazard-spawner
                type: user:Spawner
                enabled: true
                config:
                  prefab: res://scenes/prefabs/hazard.pix3scene
                  parentNode: ""
                  intervalSec: 2.2
                  intervalJitter: 0.8
                  maxAlive: 5
                  spawnWidth: 820
                  spawnHeight: 60
                  gridSnap: 0
                  driftX: 0
                  driftY: -260
                  lifetimeSec: 8
                  despawnRadius: 1450
                  startDelaySec: 1.5
            children: []
      - id: hud
        type: CanvasLayer2D
        name: HUD
        properties:
          width: 1080
          height: 1920
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        components:
          - id: score-hud
            type: user:ScoreHud
            enabled: true
            config:
              sourceNode: game-root
              scoreLabel: score-label
              scoreFormat: "SCORE {value}"
              timeLabel: time-label
              timeFormat: "{value}"
              livesBar: lives-bar
        children:
          - id: score-label
            type: Label2D
            name: Score Label
            properties:
              label: "SCORE 0"
              labelFontSize: 44
              labelColor: "#ffffff"
              labelAlign: left
              transform:
                position: [-340, 850]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: left
                verticalAlign: top
            children: []
          - id: time-label
            type: Label2D
            name: Time Label
            properties:
              label: "30"
              labelFontSize: 44
              labelColor: "#f5ae39"
              labelAlign: center
              transform:
                position: [0, 850]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: top
            children: []
          - id: lives-bar
            type: Bar2D
            name: Lives Bar
            properties:
              width: 240
              height: 28
              minValue: 0
              maxValue: 3
              value: 3
              barColor: "#ff4d6d"
              backBackgroundColor: "#2a3352"
              showBorder: false
              transform:
                position: [340, 855]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: right
                verticalAlign: top
            children: []
          - id: menu-button
            type: Button2D
            name: Menu Button
            properties:
              width: 200
              height: 72
              label: "MENU"
              labelFontSize: 30
              labelColor: "#ffffff"
              backgroundColor: "#2a3352"
              hoverColor: "#3a446b"
              pressedColor: "#1d2743"
              buttonAction: back-to-menu
              transform:
                position: [-400, -880]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: left
                verticalAlign: bottom
            children: []
          - id: result-overlay
            type: Group2D
            name: Result Overlay
            properties:
              width: 1080
              height: 1920
              initiallyVisible: false
              layout:
                enabled: true
                horizontalAlign: stretch
                verticalAlign: stretch
            children:
              - id: result-dim
                type: ColorRect2D
                name: Result Dim
                properties:
                  width: 1080
                  height: 1920
                  color: "#000000"
                  opacity: 0.7
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                  layout:
                    enabled: true
                    horizontalAlign: stretch
                    verticalAlign: stretch
                children: []
              - id: result-label
                type: Label2D
                name: Result Label
                properties:
                  label: "GAME OVER"
                  labelFontSize: 88
                  labelColor: "#ffffff"
                  labelAlign: center
                  transform:
                    position: [0, 160]
                    scale: [1, 1]
                    rotation: 0
                  layout:
                    enabled: true
                    horizontalAlign: center
                    verticalAlign: center
                children: []
              - id: retry-button
                type: Button2D
                name: Retry Button
                properties:
                  width: 420
                  height: 130
                  label: "RETRY"
                  labelFontSize: 50
                  labelColor: "#141a2e"
                  backgroundColor: "#f5ae39"
                  hoverColor: "#ffc862"
                  pressedColor: "#d4922a"
                  buttonAction: retry
                  transform:
                    position: [0, -60]
                    scale: [1, 1]
                    rotation: 0
                  layout:
                    enabled: true
                    horizontalAlign: center
                    verticalAlign: center
                children: []
