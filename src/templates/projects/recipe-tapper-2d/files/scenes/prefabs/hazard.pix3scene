# Pix3 Prefab (a .pix3scene with exactly ONE root node).
# The "bad" object: same shape as target.pix3scene, different hitbox GROUP — and
# that group alone is what makes tapping it cost a life instead of scoring (see
# TouchRules' `rules`).
version: 1.0.0
metadata:
  author: Pix3 Recipe
  description: Hazard — tapping it costs a life
root:
  - id: hazard
    type: Sprite2D
    name: Hazard
    properties:
      texture: { type: 'texture', url: 'res://sprites/ph-hazard.png' }
      width: 150
      height: 150
      effects:
        - type: core:tint
          params: { color: "#ff4d6d", amount: 1 }
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: hazard-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: circle
          radius: 70
          group: hazard
          debugDraw: false
      - id: hazard-pop
        type: core:PopIn
        enabled: true
        config:
          from: 0.2
          duration: 0.22
          easing: backOut
          playOnStart: true
          triggerEvent: ""
    children: []
