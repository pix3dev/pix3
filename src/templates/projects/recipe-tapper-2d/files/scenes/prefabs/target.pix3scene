# Pix3 Prefab (a .pix3scene with exactly ONE root node).
# Spawned by scripts/Spawner.ts via scene.instantiate().
#
# It carries only FIXED defaults — above all its `core:Hitbox2D` GROUP, which is
# what TouchRules matches a tap against. Component config on a prefab INSTANCE
# cannot be edited (the editor locks it), so every tunable lives on a plain node
# in main.pix3scene instead. Change the group here and in TouchRules' `rules`.
version: 1.0.0
metadata:
  author: Pix3 Recipe
  description: Target — tapping it scores
root:
  - id: target
    type: Sprite2D
    name: Target
    properties:
      texture: { type: 'texture', url: 'res://sprites/ph-target.png' }
      width: 150
      height: 150
      effects:
        - type: core:tint
          params: { color: "#7ee787", amount: 1 }
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: target-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: circle
          radius: 74
          group: target
          debugDraw: false
      - id: target-pop
        type: core:PopIn
        enabled: true
        config:
          from: 0.2
          duration: 0.22
          easing: backOut
          playOnStart: true
          triggerEvent: ""
    children: []
