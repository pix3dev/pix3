# Pix3 Scene File (YAML)
# Blank 2D — the GAME scene, and the one to build in. There is no menu scene on
# purpose: nothing should stand between opening the project and the gameplay
# while the mechanic is still being found.
#
# What is already wired: score / lives / timer bookkeeping, the HUD that shows
# them, and a win/lose overlay with RETRY. What is NOT here: any mechanic at all,
# including controls. That is your first increment — build it inside `board`.
#
# Stable node ids (design/recipe.md is the contract — do not rename these):
#   post-fx, game-root, game-background, bg-glow, board, board-floor,
#   hud, score-label, time-label, lives-bar,
#   result-overlay, result-dim, result-label, retry-button (scenes/ui/result.pix3scene)
#
# The look is two cheap ingredients, the same ones the bouncer recipe uses:
#   1. `post-fx` (PostProcess, affect2D) — bloom picks up whatever is bright, so
#      a bright sprite glows for free. `bloomIntensity` is a recipe tunable the
#      Flow theme pack turns up for neon and down for pastel.
#   2. `bg-glow` — a near-white radial-gradient placeholder (`sprites/ph-bg.png`)
#      tinted with the palette background, over the darkest ColorRect. It is what
#      keeps an empty field from reading as a grey slab.
#
# The win/lose overlay lives in its own file under scenes/ui/ and is instanced
# here hidden (`visible: false` = editor only), so opening this scene shows the
# field rather than a GAME OVER card.
#
# 2D coordinates: origin at the canvas centre, X right, Y UP. Node order in the
# tree is paint order (later/deeper draws on top).
version: 1.0.0
metadata:
  author: Pix3 Recipe
  description: Blank gameplay field — bookkeeping, HUD and win/lose only; the mechanic is yours
root:
  - id: post-fx
    type: PostProcess
    name: Post FX
    properties:
      affect2D: true
      bloomEnabled: true
      bloomIntensity: 0.8
      bloomThreshold: 0.6
      bloomSmoothing: 0.2
      bloomRadius: 0.75
      vignetteEnabled: true
      vignetteOffset: 0.3
      vignetteDarkness: 0.45
      chromaticAberrationEnabled: false
    children: []
  - id: game-root
    type: Group2D
    name: Game Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    components:
      - id: game-rules
        type: user:GameRules
        enabled: true
        config:
          winMode: score
          targetScore: 10
          timeLimitSec: 0
          startingLives: 3
          resultNode: result-overlay
          resultLabel: result-label
          winText: "YOU WIN!"
          loseText: "GAME OVER"
          retryButton: retry-button
          gameScene: res://scenes/main.pix3scene
          # Add your mechanic's nodes here (comma-separated) so they stop on game over.
          freezeNodes: ""
    children:
      - id: game-background
        type: ColorRect2D
        name: Game Background
        properties:
          width: 1080
          height: 1920
          color: "#12141c"
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      # Radial glow over the flat background. Near-white PNG + core:tint, so the
      # T0 palette recolours it (role `background` in design/recipe.md).
      - id: bg-glow
        type: Sprite2D
        name: Background Glow
        properties:
          texture: { type: 'texture', url: 'res://sprites/ph-bg.png' }
          width: 1080
          height: 1920
          opacity: 0.85
          effects:
            - type: core:tint
              params: { color: "#3a2f7a", amount: 1 }
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      - id: board
        type: Group2D
        name: Board
        properties:
          width: 980
          height: 1480
          transform:
            position: [0, -80]
            scale: [1, 1]
            rotation: 0
        children:
          - id: board-floor
            type: ColorRect2D
            name: Board Floor
            properties:
              width: 980
              height: 1480
              color: "#1d212e"
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
      - id: hud
        type: CanvasLayer2D
        name: HUD
        properties:
          width: 1080
          height: 1920
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        components:
          - id: score-hud
            type: user:ScoreHud
            enabled: true
            config:
              sourceNode: game-root
              scoreLabel: score-label
              scoreFormat: "SCORE {value}"
              timeLabel: time-label
              timeFormat: "{value}"
              livesBar: lives-bar
        children:
          - id: score-label
            type: Label2D
            name: Score Label
            properties:
              label: "SCORE 0"
              labelFontSize: 44
              labelColor: "#ffffff"
              labelAlign: left
              transform:
                position: [-340, 850]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: left
                verticalAlign: top
            children: []
          - id: time-label
            type: Label2D
            name: Time Label
            properties:
              label: "0"
              labelFontSize: 44
              labelColor: "#f5ae39"
              labelAlign: center
              transform:
                position: [0, 850]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: top
            children: []
          - id: lives-bar
            type: Bar2D
            name: Lives Bar
            properties:
              width: 240
              height: 28
              minValue: 0
              maxValue: 3
              value: 3
              barColor: "#ff4d6d"
              backBackgroundColor: "#2a3352"
              showBorder: false
              transform:
                position: [340, 855]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: right
                verticalAlign: top
            children: []
          # Win/lose screen — authored in scenes/ui/result.pix3scene so this
          # scene opens on the GAME, not on a GAME OVER card. `visible: false`
          # hides it in the EDITOR only; `initiallyVisible` (in the overlay
          # file) is what play mode reads, and GameRules reveals it on the
          # win/lose transition. Tick the eye to preview it over the field.
          - id: result-overlay
            name: Result Overlay
            instance: res://scenes/ui/result.pix3scene
            properties:
              visible: false
