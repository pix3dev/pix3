# Pix3 Scene File (YAML)
# Bouncer 2D — the GAME scene, and the editor's startup scene: iterate here.
# A full build boots the MENU (menu.pix3scene), whose PLAY transitions here.
#
# The physics is NOT engine physics. `scripts/BallBody.ts` runs a swept
# (continuous) circle solver and reads its colliders from the LIVE WORLD
# TRANSFORMS of the marker nodes below — so rotating `paddle` (or adding
# flippers) works with no extra code, and no `core:Hitbox2D` is involved:
#   walls/*   -> oriented boxes    bumpers/* -> circles
#   paddles/* -> oriented boxes    drain     -> trigger box (lose a ball)
#
# Stable node ids (design/recipe.md is the contract — do not rename these):
#   game-root, game-background, board, walls, wall-left, wall-right, wall-top,
#   bumpers, bumper-a, bumper-b, bumper-c, paddles, paddle, ball, drain,
#   hud, score-label, time-label, lives-bar, menu-button,
#   result-overlay, result-label, retry-button
#
# 2D coordinates: origin at the canvas centre, X right, Y UP. Node order in the
# tree is paint order (later/deeper draws on top). `rotation` here is DEGREES.
version: 1.0.0
metadata:
  author: Pix3 Recipe
  description: Bouncer gameplay — a ball under gravity, a paddle, bumpers and a drain
root:
  - id: game-root
    type: Group2D
    name: Game Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    components:
      - id: game-rules
        type: user:GameRules
        enabled: true
        config:
          winMode: score
          targetScore: 1500
          timeLimitSec: 0
          startingLives: 3
          resultNode: result-overlay
          resultLabel: result-label
          winText: "YOU WIN!"
          loseText: "GAME OVER"
          retryButton: retry-button
          menuButton: menu-button
          menuScene: res://scenes/menu.pix3scene
          gameScene: res://scenes/main.pix3scene
          freezeNodes: ball,paddle
      - id: touch-rules
        type: user:TouchRules
        enabled: true
        config:
          ballNode: ball
          rules: "bumper:score:100;paddle:score:10;drain:damage:1"
          minImpactSpeed: 60
          scoreSound: ""
          damageSound: ""
    children:
      - id: game-background
        type: ColorRect2D
        name: Game Background
        properties:
          width: 1080
          height: 1920
          color: "#141a2e"
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      - id: board
        type: Group2D
        name: Board
        properties:
          width: 1000
          height: 1600
          transform:
            position: [0, -60]
            scale: [1, 1]
            rotation: 0
        children:
          - id: board-floor
            type: ColorRect2D
            name: Board Floor
            properties:
              width: 1000
              height: 1600
              color: "#1d2743"
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: drain
            type: ColorRect2D
            name: Drain
            properties:
              width: 1000
              height: 160
              color: "#ff4d6d"
              opacity: 0.22
              transform:
                position: [0, -760]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: walls
            type: Group2D
            name: Walls
            properties:
              width: 1000
              height: 1600
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children:
              - id: wall-left
                type: ColorRect2D
                name: Wall Left
                properties:
                  width: 40
                  height: 1600
                  color: "#39456f"
                  transform:
                    position: [-480, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: wall-right
                type: ColorRect2D
                name: Wall Right
                properties:
                  width: 40
                  height: 1600
                  color: "#39456f"
                  transform:
                    position: [480, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: wall-top
                type: ColorRect2D
                name: Wall Top
                properties:
                  width: 1000
                  height: 40
                  color: "#39456f"
                  transform:
                    position: [0, 780]
                    scale: [1, 1]
                    rotation: 0
                children: []
          - id: bumpers
            type: Group2D
            name: Bumpers
            properties:
              width: 1000
              height: 1600
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children:
              - id: bumper-a
                type: Sprite2D
                name: Bumper A
                properties:
                  texture: { type: 'texture', url: 'res://sprites/ph-bumper.png' }
                  width: 160
                  height: 160
                  effects:
                    - type: core:tint
                      params: { color: "#7ee787", amount: 1 }
                  transform:
                    position: [-230, 260]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: bumper-b
                type: Sprite2D
                name: Bumper B
                properties:
                  texture: { type: 'texture', url: 'res://sprites/ph-bumper.png' }
                  width: 160
                  height: 160
                  effects:
                    - type: core:tint
                      params: { color: "#7ee787", amount: 1 }
                  transform:
                    position: [230, 260]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: bumper-c
                type: Sprite2D
                name: Bumper C
                properties:
                  texture: { type: 'texture', url: 'res://sprites/ph-bumper.png' }
                  width: 160
                  height: 160
                  effects:
                    - type: core:tint
                      params: { color: "#7ee787", amount: 1 }
                  transform:
                    position: [0, 520]
                    scale: [1, 1]
                    rotation: 0
                children: []
          - id: paddles
            type: Group2D
            name: Paddles
            properties:
              width: 1000
              height: 1600
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children:
              - id: paddle
                type: Sprite2D
                name: Paddle
                properties:
                  texture: { type: 'texture', url: 'res://sprites/ph-paddle.png' }
                  width: 300
                  height: 60
                  effects:
                    - type: core:tint
                      params: { color: "#f5ae39", amount: 1 }
                  transform:
                    position: [0, -620]
                    scale: [1, 1]
                    rotation: 0
                components:
                  - id: paddle-controller
                    type: user:PaddleController
                    enabled: true
                    config:
                      mode: pointer
                      speed: 1800
                      halfWidth: 150
                      boundsNode: board
                children: []
          - id: ball
            type: Sprite2D
            name: Ball
            properties:
              texture: { type: 'texture', url: 'res://sprites/ph-ball.png' }
              width: 60
              height: 60
              effects:
                - type: core:tint
                  params: { color: "#ffffff", amount: 1 }
              transform:
                position: [0, 120]
                scale: [1, 1]
                rotation: 0
            components:
              - id: ball-body
                type: user:BallBody
                enabled: true
                config:
                  radius: 30
                  gravity: -1600
                  maxSpeed: 1900
                  minSpeed: 380
                  damping: 0.999
                  substeps: 4
                  launchSpeed: 900
                  launchAngleDeg: 72
                  wallsNode: walls
                  paddlesNode: paddles
                  bumpersNode: bumpers
                  drainNode: drain
                  wallRestitution: 1
                  paddleRestitution: 1.05
                  bumperRestitution: 1.3
                  resetDelaySec: 0.7
            children: []
      - id: hud
        type: CanvasLayer2D
        name: HUD
        properties:
          width: 1080
          height: 1920
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        components:
          - id: score-hud
            type: user:ScoreHud
            enabled: true
            config:
              sourceNode: game-root
              scoreLabel: score-label
              scoreFormat: "SCORE {value}"
              timeLabel: time-label
              timeFormat: "{value}s"
              livesBar: lives-bar
        children:
          - id: score-label
            type: Label2D
            name: Score Label
            properties:
              label: "SCORE 0"
              labelFontSize: 44
              labelColor: "#ffffff"
              labelAlign: left
              transform:
                position: [-340, 880]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: left
                verticalAlign: top
            children: []
          - id: time-label
            type: Label2D
            name: Time Label
            properties:
              label: "0s"
              labelFontSize: 44
              labelColor: "#f5ae39"
              labelAlign: center
              transform:
                position: [0, 880]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: top
            children: []
          - id: lives-bar
            type: Bar2D
            name: Lives Bar
            properties:
              width: 240
              height: 28
              minValue: 0
              maxValue: 3
              value: 3
              barColor: "#ff4d6d"
              backBackgroundColor: "#2a3352"
              showBorder: false
              transform:
                position: [340, 885]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: right
                verticalAlign: top
            children: []
          - id: menu-button
            type: Button2D
            name: Menu Button
            properties:
              width: 200
              height: 72
              label: "MENU"
              labelFontSize: 30
              labelColor: "#ffffff"
              backgroundColor: "#2a3352"
              hoverColor: "#3a446b"
              pressedColor: "#1d2743"
              buttonAction: back-to-menu
              transform:
                position: [-400, -900]
                scale: [1, 1]
                rotation: 0
              layout:
                enabled: true
                horizontalAlign: left
                verticalAlign: bottom
            children: []
          - id: result-overlay
            type: Group2D
            name: Result Overlay
            properties:
              width: 1080
              height: 1920
              initiallyVisible: false
              layout:
                enabled: true
                horizontalAlign: stretch
                verticalAlign: stretch
            children:
              - id: result-dim
                type: ColorRect2D
                name: Result Dim
                properties:
                  width: 1080
                  height: 1920
                  color: "#000000"
                  opacity: 0.7
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                  layout:
                    enabled: true
                    horizontalAlign: stretch
                    verticalAlign: stretch
                children: []
              - id: result-label
                type: Label2D
                name: Result Label
                properties:
                  label: "GAME OVER"
                  labelFontSize: 88
                  labelColor: "#ffffff"
                  labelAlign: center
                  transform:
                    position: [0, 160]
                    scale: [1, 1]
                    rotation: 0
                  layout:
                    enabled: true
                    horizontalAlign: center
                    verticalAlign: center
                children: []
              - id: retry-button
                type: Button2D
                name: Retry Button
                properties:
                  width: 420
                  height: 130
                  label: "RETRY"
                  labelFontSize: 50
                  labelColor: "#141a2e"
                  backgroundColor: "#f5ae39"
                  hoverColor: "#ffc862"
                  pressedColor: "#d4922a"
                  buttonAction: retry
                  transform:
                    position: [0, -60]
                    scale: [1, 1]
                    rotation: 0
                  layout:
                    enabled: true
                    horizontalAlign: center
                    verticalAlign: center
                children: []
