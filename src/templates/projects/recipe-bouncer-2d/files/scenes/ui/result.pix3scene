# Pix3 Scene File (YAML)
# Bouncer 2D — the RESULT overlay (win/lose), in its own file so the gameplay
# scene opens clean. `main.pix3scene` carries it as a one-line
# `instance:` reference marked `visible: false`, which hides it in the EDITOR
# only; `user:GameRules` reveals it at run time by setting `visible`.
#
# Edit it here, full-screen, in its own tab. To preview it composited over the
# game, tick the eye on `result-overlay` in main.pix3scene — just do not commit
# that tick, or every iteration starts behind a GAME OVER screen again.
#
# Stable node ids (design/recipe.md is the contract — do not rename these):
#   result-overlay, result-label, retry-button
version: 1.0.0
metadata:
  author: Pix3 Recipe
  description: Result overlay — dim, glowing win/lose headline and a RETRY button
root:
  - id: result-overlay
    type: Group2D
    name: Result Overlay
    properties:
      width: 1080
      height: 1920
      initiallyVisible: false
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
    children:
      - id: result-dim
        type: ColorRect2D
        name: Result Dim
        properties:
          width: 1080
          height: 1920
          color: "#05030f"
          opacity: 0.78
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
        children: []
      - id: result-label
        type: Label2D
        name: Result Label
        properties:
          label: "GAME OVER"
          labelFontSize: 96
          labelColor: "#ffffff"
          labelAlign: center
          glowColor: "#2ef2ff"
          glowStrength: 2.5
          transform:
            position: [0, 160]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: center
        children: []
      - id: retry-button
        type: Button2D
        name: Retry Button
        properties:
          width: 420
          height: 130
          label: "RETRY"
          labelFontSize: 50
          labelColor: "#0d0724"
          backgroundColor: "#ffd23f"
          hoverColor: "#ffe98a"
          pressedColor: "#d49a1f"
          buttonAction: retry
          transform:
            position: [0, -60]
            scale: [1, 1]
            rotation: 0
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: center
        children: []
