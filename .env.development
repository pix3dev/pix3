# `npm run dev` — editor against a LOCAL backend (`npm run dev:collab` starts one on 4001).
#
# Vite loads mode files AFTER `.env` / `.env.local`, so this pins the dev target no matter what a
# stray personal override says. Need a different local port? Put it in `.env.development.local`
# (mode-local wins over this file). To point a local editor at production, use `npm run dev:prod`.
VITE_COLLAB_SERVER_URL=http://localhost:4001
