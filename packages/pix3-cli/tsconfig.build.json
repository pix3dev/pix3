{
  "extends": "./tsconfig.json",
  // The Node-runnable subset: every file `node src/index.ts` can load (Node 24 type stripping),
  // checked under the constraints that mode needs. It type-checks only — the published bin is the
  // single-file esbuild bundle `dist/index.js` (`scripts/build-bin.mjs`), not a `tsc` emit.
  //
  // Specs are type-checked by `tsconfig.json` but never shipped. `src/validate/**` and
  // `src/smoke/**` (plus `tree/defaults.ts`) are bundled separately (they pull in `@pix3/runtime`
  // from source); only their Node-runnable files reached from `index.ts` (`validate/entry.ts`,
  // `smoke/command.ts` → `entry.ts` / `report.ts`) are checked here.
  "exclude": ["src/**/*.spec.ts", "src/validate/**", "src/smoke/**", "src/tree/defaults.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    // Node's type stripping rejects enums, namespaces and parameter properties.
    "erasableSyntaxOnly": true,
    // Sources import with explicit `.ts` extensions (so `node src/index.ts` runs them as-is on
    // Node 24). Node refuses to strip types under node_modules, which is why the published bin is
    // bundled JavaScript rather than the sources.
    "rewriteRelativeImportExtensions": true
  }
}
