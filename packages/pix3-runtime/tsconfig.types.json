{
  // Declarations of the public entry (`src/index.ts`) for `@pix3/cli` (`pix3 check` type-checks a
  // project's scripts against them; `packages/pix3-cli/scripts/build-runtime-types.mjs`). Only
  // what `index.ts` reaches is compiled — specs, `testing/` and `main.ts` never are, so this build
  // is clean while `tsc -p .` still reports pre-existing errors in specs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "rootDir": "./src",
    "outDir": "./dist-types",
    "skipLibCheck": true
  },
  "include": [],
  "files": ["src/index.ts"]
}
