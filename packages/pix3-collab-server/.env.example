PORT_HTTP=4001
PORT_WS=4000

# Базы данных и хранилище
DB_PATH=./data/core.sqlite
HOCUSPOCUS_DB_PATH=./data/crdt.sqlite
PROJECTS_STORAGE_DIR=./data/projects

# Безопасность
JWT_SECRET=super_secret_string_here
PASSWORD_SALT_ROUNDS=10

# Room Fabric (pix3-rooms). Этот сервер — единственный, у кого есть service token
# фабрики и HS256-секрет: он создаёт комнаты и подписывает room-токены игрокам.
# Пустой ROOMS_ADMIN_URL выключает /api/rooms (503), а не «наполовину включает».
ROOMS_ADMIN_URL=https://rooms.pix3.dev
ROOMS_SERVICE_TOKEN=same_value_as_Rooms__Auth__ServiceToken
# По умолчанию выводится из ROOMS_ADMIN_URL (http→ws, + /ws).
# ROOMS_WS_URL=wss://rooms.pix3.dev/ws
# Должен совпадать с Rooms__Auth__JwtSecret на фабрике, минимум 32 байта.
# По умолчанию берётся JWT_SECRET — на одном хосте это один и тот же секрет.
# ROOMS_JWT_SECRET=
# ROOMS_TOKEN_ISSUER=pix3-cloud
# ROOMS_TOKEN_AUDIENCE=pix3-rooms
# ROOMS_TOKEN_TTL_SECONDS=21600
# ROOMS_CREATE_PER_MINUTE=12
