          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 35]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: carried-mine
        type: Sprite2D
        name: Carried Mine
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/mine.png' }
