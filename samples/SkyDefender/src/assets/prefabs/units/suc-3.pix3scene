# SUC Mines — enemy air unit, id 28 (`SUC_3`): two-`Mine` rack hugging the gasbag, no basket and no gun.
# Rig transcribed verbatim from the decompiled `com.enemy.SUC_3.init()`
# (session export of design/noAds.swf):
#
#   Mine b: x = -22;  y = -2   (TOP-LEFT) -> centre (-22+9.5, -2+10.5) = (-12.5, +8.5)
#   Mine c: x =   4;  y = -2   (TOP-LEFT) -> centre (  4+9.5, -2+10.5) = (+13.5, +8.5)
#   B_SUC : x -= w>>1;  y -= (h>>1)+5;     -> centre (0, -5)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "SUC Mines (unit prefab, SUC_3)"
root:
  - id: unit
    type: Sprite2D
    name: SUC Mines
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/typical_bloon/SU_typical.png' }
      width: 66
      height: 38
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
