# Unik Sniper — enemy air unit, id 35 (`Unik_1`): carriage with the 55x10 `B_TypSnp` sniper barrel, `rld_max 70`.
# Rig transcribed verbatim from the decompiled `com.enemy.Unik_1.init()`
# (session export of design/noAds.swf):
#
#   B_unik_ropes: x = -25;  y = -13  -> centre (  +1, +3.5)
#   B_unik_s    : x = -25;  y = -36  -> centre (  +2, -17.5)
#   B_unik_body : x = -32;  y =   6  -> centre (-1.5, +22.5)
#   TypGunMob   : x = -16;  y =  28;  tip = 4;  grad = 2;  rld_max = 70
#     B_TypSnp  : x =  30;  y =  -4;  scaleX = -1
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is a Group2D at the unit origin, so every child is just
# flipped to pix3 y-up:  pix3 = (fx, -fy).  The carriage weapon is nested
# under `Unik Gondola` and so is additionally offset by [1.5, 22.5].
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Unik Sniper (unit prefab, Unik_1)"
root:
  - id: unit
    type: Group2D
    name: Unik Sniper
    properties:
      width: 70
      height: 92
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-logic
        type: user:CompoundBalloon
        enabled: true
        config:
          bodyHp: 100
          ropesHp: 30
          gondolaHp: 60
          speed: 40
          stopX: 0
          score: 20
          gondolaScore: 8
          castleDamage: 90
          wreckBodyTex: 'res://src/assets/textures/enemy/air/unik/unik_body.png'
          wreckGondolaTex: 'res://src/assets/textures/enemy/air/unik/unik_body.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Unik Sniper · L23"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 56]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: unik-ropes
        type: Sprite2D
        name: Unik Ropes
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/unik/unik_ropes.png' }
          width: 52
          height: 33
          transform:
            position: [1, -3.5]
            scale: [1, 1]
            rotation: 0
        components:
          - id: unik-ropes-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 47
              height: 28
              offsetX: 0
              offsetY: 0
              group: enemy
              debugDraw: false
        children: []
      - id: unik-body
        type: Sprite2D
        name: Unik Body
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/unik/unik_s.png' }
          width: 54
          height: 37
          transform:
            position: [2, 17.5]
            scale: [1, 1]
            rotation: 0
        components:
          - id: unik-body-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 49
              height: 32
              offsetX: 0
              offsetY: 0
              group: enemy
              debugDraw: false
        children: []
      - id: unik-gondola
        type: Sprite2D
        name: Unik Gondola
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/unik/unik_body.png' }
          width: 61
          height: 33
          transform:
            position: [-1.5, -22.5]
            scale: [1, 1]
            rotation: 0
        components:
          - id: unik-gondola-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 56
              height: 28
              offsetX: 0
              offsetY: 0
              group: enemy
              debugDraw: false
        children:
          - id: unik-gun
            type: Group2D
            name: Unik Gun
            properties:
              width: 55
              height: 10
              transform:
                position: [-14.5, -5.5]
                scale: [1, 1]
                rotation: 0
            children:
              - id: unik-gun-barrel
                type: Sprite2D
                name: Gun
                properties:
                  texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/big_gun1.png' }
                  width: 55
                  height: 10
                  transform:
                    position: [-2.5, 1]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: unik-gun-flash
                type: Sprite2D
