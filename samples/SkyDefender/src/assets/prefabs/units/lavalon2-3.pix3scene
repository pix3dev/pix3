# Lavalon 2 Burning — enemy air unit, id 19 (`Lavalon2_3`): a BURNING hull — two `Burn1` + one `Burn2`, no weapon at all.
# Rig transcribed verbatim from the decompiled `com.enemy.Lavalon2_3.init()`
# (session export of design/noAds.swf):
#
#   Burn1: x += 55;  y -= 12;  rotation = 90
#   Burn1: x += 30;  y -= 4;   rotation = 90
#   Burn2: x = -30;  y = -7;   rotation = 90;  scaleX = scaleY = 0.7
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
#
# APPROXIMATION:
#   the first `Burn1` is added BEFORE the hull bitmap in `init()`, so the original
#   draws it behind the hull; here the body is the prefab ROOT and always paints
#   under its children, so all three flames paint over it.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Lavalon 2 Burning (unit prefab, Lavalon2_3)"
root:
  - id: unit
    type: Sprite2D
    name: Lavalon 2 Burning
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/lavalon2/lavalon2.png' }
      width: 107
      height: 30
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 101
          height: 26
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: ''
          spritePath: 'res://src/assets/textures/enemy/air/lavalon2/lavalon2.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Lavalon 2 Burning · unused in campaign"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 31]
            scale: [1, 1]
            rotation: 0
        children: []
      # Hidden damage overlay (`B_AvalonC`/`B_LavalonC`): `init()` builds it with
      # `visible = false` and swaps it in when the hull is wrecked.
      - id: gondola-overlay
        type: Sprite2D
        name: Gondola
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/lavalon_gondola.png' }
          width: 107
          height: 30
          visible: false
          initiallyVisible: false
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: flame-1
        type: AnimatedSprite2D
        name: Flame 1
        properties:
          animationResourcePath: res://src/assets/textures/sfx/fire/fire.pix3anim
          currentClip: burn
          isPlaying: true
          freeOnFinish: false
          width: 20
          height: 34
          opacity: 1
          transform:
            position: [55, 7]
            scale: [1, 1]
            rotation: -90
        children: []
      - id: flame-2
        type: AnimatedSprite2D
        name: Flame 2
        properties:
          animationResourcePath: res://src/assets/textures/sfx/fire/fire.pix3anim
          currentClip: burn
          isPlaying: true
          freeOnFinish: false
          width: 20
          height: 34
          opacity: 1
          transform:
            position: [30, -1]
            scale: [1, 1]
            rotation: -90
        children: []
      - id: flame-3
        type: AnimatedSprite2D
        name: Flame 3
        properties:
