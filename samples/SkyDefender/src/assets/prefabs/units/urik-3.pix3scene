# Urik Big Gun — enemy air unit, id 45 (`Urik_3`): carriage with the `BigGun` (the 55x10 heavy barrel), mirrored.
# Rig transcribed verbatim from the decompiled `com.enemy.Urik_3.init()`
# (session export of design/noAds.swf):
#
#   B_urik_ropes/B_urik_s/B_urik_body as Urik_1
#   _mobGun = new BigGun();  x = -21;  y = 26;  scaleX *= -1;
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is a Group2D at the unit origin, so every child is just
# flipped to pix3 y-up:  pix3 = (fx, -fy).  The carriage weapon is nested
# under `Unik Gondola` and so is additionally offset by [0, 15].
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Urik Big Gun (unit prefab, Urik_3)"
root:
  - id: unit
    type: Group2D
    name: Urik Big Gun
    properties:
      width: 70
      height: 92
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
