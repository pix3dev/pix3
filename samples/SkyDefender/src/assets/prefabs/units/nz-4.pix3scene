# NZ Burning — enemy air unit, id 24 (`NZ_4`): a burning wreck-in-flight — three `Burn2`, no weapon.
# Rig transcribed verbatim from the decompiled `com.enemy.NZ_4.init()`
# (session export of design/noAds.swf):
#
#   Burn2: x = -6;   y = -7;  rotation = 90
#   B_NZ : x -= w>>1;  y -= (h>>1)+5;  -> centre (0, -5)
#   Burn2: x = 2;    y = -7;  rotation = 90
#   Burn2: x = -15;  y = -4;  rotation = 90
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
#
# APPROXIMATION:
#   the first `Burn2` is added BEFORE the gasbag in `init()` (behind it); the body
#   is this prefab's ROOT and always paints under its children, so all three
#   flames paint over the gasbag here.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "NZ Burning (unit prefab, NZ_4)"
root:
  - id: unit
    type: Sprite2D
    name: NZ Burning
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/typical_bloon/Nazi_typical.png' }
      width: 66
      height: 38
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 60
          height: 34
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
