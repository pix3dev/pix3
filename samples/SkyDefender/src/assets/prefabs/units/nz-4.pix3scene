        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: ''
          spritePath: 'res://src/assets/textures/enemy/air/typical_bloon/Nazi_typical.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "NZ Burning · unused in campaign"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 35]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: flame-1
        type: AnimatedSprite2D
        name: Flame 1
        properties:
          animationResourcePath: res://src/assets/textures/sfx/fire/fire.pix3anim
          currentClip: burn
          isPlaying: true
          freeOnFinish: false
          width: 57
          height: 89
          opacity: 1
          transform:
            position: [-6, 2]
            scale: [1, 1]
            rotation: -90
        children: []
      - id: flame-2
        type: AnimatedSprite2D
        name: Flame 2
        properties:
          animationResourcePath: res://src/assets/textures/sfx/fire/fire.pix3anim
          currentClip: burn
          isPlaying: true
          freeOnFinish: false
          width: 57
          height: 89
          opacity: 1
          transform:
            position: [2, 2]
            scale: [1, 1]
            rotation: -90
        children: []
      - id: flame-3
        type: AnimatedSprite2D
        name: Flame 3
        properties:
          animationResourcePath: res://src/assets/textures/sfx/fire/fire.pix3anim
          currentClip: burn
