# Slevin Fire — enemy air unit (bomber, FIRE bomb (tpb 3: stone + flame)). Composition transcribed from the
# decompiled com.enemy.* init(). (design/original-data/release-v15/air-composition.md
# transcribed only the `_1` variant of each family and is wrong here — see
# .plans/enemy-fidelity-audit.md §3 and the rig quoted below.)
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# RIG (verbatim from the decompiled `com.enemy.Slevin_2.init()`, session export of
# design/noAds.swf) — Flash offsets are y-DOWN, relative to the unit origin, and
# bitmaps are placed by top-left then centred:
#   Burn1   : y += 30;  x += 15;  rotation = 90  -> unit origin (+15, +30)
#   Stoneb  : x -= w>>1;  y -= (h>>1) - 25;      -> centre (0, +25)
#   Littlebg: x -= w>>1;  y -= (h>>1) - 29;      -> centre (0, +29)
#   B_Slevin: x -= w>>1;  y -= (h>>1) + 5;       -> centre (0, -5)
# The body is this prefab's ROOT, so each child is rebased onto the body centre
# (Flash y + 5) and flipped to pix3 y-up:  pix3 = (fx, -(fy + 5)).
# There is no `B_Korzina`/weapon-support bitmap anywhere in `init()`: the two
# thin straps under the bomb are drawn INTO its bitmap (`Mine` is 19x21 and
# `Stoneb` 13x25 for a 13 px ball), so the separate `Weapon Mount` basket this
# prefab used to carry was a remaster invention and has been removed.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Slevin Fire (unit prefab)"
root:
  - id: unit
    type: Sprite2D
    name: Slevin Fire
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/bomber_slevin/bslevin.png' }
      width: 40
      height: 45
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 34
          height: 41
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: true
          gunType: ''
          spritePath: 'res://src/assets/textures/enemy/air/bomber_slevin/bslevin.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Slevin Fire · L1,2,4,6,13,14,17,19,29"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 38]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: carried-mine
        type: Sprite2D
        name: Carried Mine
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/stoneb.png' }
          width: 13
          height: 25
          transform:
            position: [0, -30]
            scale: [1, 1]
            rotation: 0
        components:
          - id: mine-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 13
              height: 13
              offsetX: 0
              offsetY: -6.5
              group: enemy
              debugDraw: false
        children: []
      # Littlebg sits 4 px below the bomb centre, i.e. on the BALL half of the
      # Stoneb bitmap; `init()` adds it after Stoneb, so it paints over it.
      - id: bomb-glow
        type: Sprite2D
        name: Bomb Glow
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/littlebg.png' }
          width: 23
          height: 23
          transform:
            position: [0, -34]
            scale: [1, 1]
            rotation: 0
        children: []
      # Burn1, `rotation = 90` (Flash, clockwise) = -90 in pix3's y-up degrees,
      # so the flame streams BACKWARD off the leftbound unit. Size/anchor are
      # approximate: Burn1 is a MovieClip and FFDec cannot recover its
      # registration point, only its 35x65 bounds at 1x (this uses the same
      # 20x34 reduction as `nz-fire.pix3scene`).
      - id: bomb-flame
        type: AnimatedSprite2D
        name: Bomb Flame
        properties:
          animationResourcePath: res://src/assets/textures/sfx/fire/fire.pix3anim
          currentClip: burn
          isPlaying: true
          freeOnFinish: false
          width: 20
          height: 34
          opacity: 1
          transform:
            position: [15, -35]
            scale: [1, 1]
            rotation: -90
        children: []
