# Unik Plane Gun — enemy air unit, id 40 (`Unik_6`): a PLANE with a `B_TypGun`, `rld_max 20` — the LEVEL-1 "ATS" (t = 37).
# Rig transcribed verbatim from the decompiled `com.enemy.Unik_6.init()`
# (session export of design/noAds.swf):
#
#   TypGunMob: x = -13;  y = 10;  tip = 3;  grad = 4;  rld_max = 20
#     B_TypGun: x = 20;  y = -4.5;  scaleX = -1
#   B_unik_nd: x = -28;  y = -13  (TOP-LEFT, 56x23) -> centre (0, -1.5)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -1.5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 1.5))
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Unik Plane Gun (unit prefab, Unik_6)"
