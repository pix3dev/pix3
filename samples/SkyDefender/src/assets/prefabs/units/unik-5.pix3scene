# Unik Plane Sniper — enemy air unit, id 39 (`Unik_5`): a PLANE, not a balloon: fighter airframe + 55x10 `B_TypSnp`, `rld_max 25`.
# Rig transcribed verbatim from the decompiled `com.enemy.Unik_5.init()`
# (session export of design/noAds.swf):
#
#   B_unik_nd: x = -28;  y = -13  (TOP-LEFT, 56x23) -> centre (0, -1.5)
#   TypGunMob: x = -16;  y =  11;  tip = 4;  grad = 3;  rld_max = 25
#     B_TypSnp: x = 30;  y = -4;  scaleX = -1
#   (no B_unik_s / B_unik_ropes / B_unik_body anywhere in init())
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -1.5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 1.5))
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Unik Plane Sniper (unit prefab, Unik_5)"
root:
  - id: unit
    type: Sprite2D
    name: Unik Plane Sniper
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/unik/unik_nd.png' }
      width: 56
      height: 23
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 50
          height: 19
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: 'heavy'
          spritePath: 'res://src/assets/textures/enemy/air/unik/unik_nd.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Unik Plane Sniper · L6,8,9,10,12,19,23,24,26,28,30"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 27.5]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: mount-a
        type: Group2D
        name: Mount A
        properties:
          width: 55
          height: 10
          transform:
            position: [-16, -12.5]
            scale: [1, 1]
            rotation: 0
        children:
          - id: mount-a-barrel
            type: Sprite2D
            name: Gun
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/big_gun1.png' }
              width: 55
              height: 10
              transform:
                position: [-2.5, 1]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: mount-a-flash
            type: Sprite2D
            name: Muzzle Flash
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/sfx/blowglow.png' }
              width: 16
              height: 16
              opacity: 0
              transform:
                position: [-30, 1]
                scale: [1, 1]
                rotation: 0
            children: []
