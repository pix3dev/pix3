# Urik Plane Gun — enemy air unit, id 46 (`Urik_4`): a PLANE, not a balloon: biplane airframe + `B_TypGun`, `rld_max 20`.
# Rig transcribed verbatim from the decompiled `com.enemy.Urik_4.init()`
# (session export of design/noAds.swf):
#
#   B_urik_nd: x = -28;  y = -13  (TOP-LEFT, 72x24) -> centre (+8, -1)
#   TypGunMob: x =   4;  y =   9;  tip = 3;  grad = 5;  rld_max = 20
#     B_TypGun: x = 20;  y = -4.5;  scaleX = -1
#   (no B_urik_s / B_urik_ropes / B_urik_body anywhere in init())
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (8, -1)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx - 8, -(fy + 1))
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Urik Plane Gun (unit prefab, Urik_4)"
root:
  - id: unit
    type: Sprite2D
    name: Urik Plane Gun
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/urik/urik_nd.png' }
      width: 72
      height: 24
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 66
          height: 20
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: 'typical'
          spritePath: 'res://src/assets/textures/enemy/air/urik/urik_nd.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Urik Plane Gun · L19,20,23,27"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 28]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: mount-a
        type: Group2D
        name: Mount A
        properties:
          width: 23
          height: 9
          transform:
            position: [-4, -10]
            scale: [1, 1]
            rotation: 0
        children:
          - id: mount-a-barrel
            type: Sprite2D
            name: Gun
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/typical_gun.png' }
              width: 23
              height: 9
              transform:
                position: [-8.5, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: mount-a-flash
            type: Sprite2D
            name: Muzzle Flash
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/sfx/blowglow.png' }
              width: 16
              height: 16
              opacity: 0
              transform:
                position: [-20, 0]
                scale: [1, 1]
                rotation: 0
            children: []
