# Lavalon 2 Mines — enemy air unit, id 20 (`Lavalon2_4`): two-`Mine` rack, no gun.
# Rig transcribed verbatim from the decompiled `com.enemy.Lavalon2_4.init()`
# (session export of design/noAds.swf):
#
#   Mine b: x -= (w>>1)+6;   y -= (h>>1)-7;  -> centre (-6, +7)
#   Mine c: x -= (w>>1)-25;  y -= (h>>1)-2;  -> centre (+25, +2)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Lavalon 2 Mines (unit prefab, Lavalon2_4)"
root:
  - id: unit
    type: Sprite2D
    name: Lavalon 2 Mines
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/lavalon2/lavalon2.png' }
      width: 107
      height: 30
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 101
          height: 26
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: ''
          spritePath: 'res://src/assets/textures/enemy/air/lavalon2/lavalon2.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Lavalon 2 Mines · L17"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 31]
            scale: [1, 1]
            rotation: 0
        children: []
      # Hidden damage overlay (`B_AvalonC`/`B_LavalonC`): `init()` builds it with
      # `visible = false` and swaps it in when the hull is wrecked.
      - id: gondola-overlay
        type: Sprite2D
        name: Gondola
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/lavalon_gondola.png' }
          width: 107
          height: 30
          visible: false
          initiallyVisible: false
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: carried-mine
        type: Sprite2D
        name: Carried Mine
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/mine.png' }
          width: 19
          height: 21
          transform:
            position: [-6, -12]
            scale: [1, 1]
            rotation: 0
        components:
          - id: carried-mine-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 19
              height: 21
              offsetX: 0
              offsetY: 0
              group: enemy
              debugDraw: false
        children: []
      - id: bomb-2
