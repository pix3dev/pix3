          height: 13
          transform:
            position: [-8, -25]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: mount-a
        type: Group2D
        name: Mount A
        properties:
          width: 23
          height: 9
          transform:
            position: [-51, -23]
            scale: [1, 1]
            rotation: 0
        children:
          - id: mount-a-barrel
            type: Sprite2D
            name: Gun
