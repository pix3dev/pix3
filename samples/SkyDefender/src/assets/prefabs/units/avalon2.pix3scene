# Avalon 2 — enemy air unit, id 9 (`Avalon2_1`): twin gun-baskets (`B_Korzina` + `TypGunMob`/`B_TypGun`).
# Rig transcribed verbatim from the decompiled `com.enemy.Avalon2_1.init()`
# (session export of design/noAds.swf):
#
#   TypGunMob: x = -51; y = 18; tip = 0      TypGunMob: x = -9; y = 24; tip = 1
#   B_Korzina a: x -= (w>>1)+8;   y -= (h>>1)-20;  -> centre (-8, +20)
#   B_Korzina b: x -= (w>>1)+50;  y -= (h>>1)-14;  -> centre (-50, +14)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Avalon 2 (unit prefab, Avalon2_1)"
root:
  - id: unit
    type: Sprite2D
    name: Avalon 2
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/avalon2/avalon2.png' }
      width: 167
      height: 46
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 161
          height: 42
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: 'typical'
          spritePath: 'res://src/assets/textures/enemy/air/avalon2/avalon2.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Avalon 2 · L13,14,24,28"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 39]
            scale: [1, 1]
            rotation: 0
        children: []
      # Hidden damage overlay (`B_AvalonC`/`B_LavalonC`): `init()` builds it with
      # `visible = false` and swaps it in when the hull is wrecked.
      - id: gondola-overlay
        type: Sprite2D
        name: Gondola
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/avalon_gondola.png' }
          width: 167
          height: 46
          visible: false
          initiallyVisible: false
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: weapon-mount
        type: Sprite2D
        name: Weapon Mount
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/korzina.png' }
          width: 20
          height: 13
          transform:
            position: [-50, -19]
            scale: [1, 1]
            rotation: 0
        components:
          - id: weapon-mount-hitbox
            type: core:Hitbox2D
            enabled: true
