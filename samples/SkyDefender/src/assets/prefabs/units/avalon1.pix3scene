# Avalon 1 — enemy air unit, id 5 (`Avalon1_1`): heavy gunship, nose `BigGun`.
# Rig transcribed verbatim from the decompiled `com.enemy.Avalon1_1.init()`
# (session export of design/noAds.swf):
#
#   _mobGun = new BigGun();  x -= 67;  y += 4;  scaleX *= -1;
#   B_AvalonC: x -= w>>1;  y -= (h>>1)+5;  visible = false;
#   B_Avalon1: x -= w>>1;  y -= (h>>1)+5;      -> centre (0, -5)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Avalon 1 (unit prefab, Avalon1_1)"
root:
  - id: unit
    type: Sprite2D
    name: Avalon 1
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/avalon1/avalon1.png' }
      width: 167
      height: 46
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 161
          height: 42
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: 'heavy'
          spritePath: 'res://src/assets/textures/enemy/air/avalon1/avalon1.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Avalon 1 · L29"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 39]
            scale: [1, 1]
            rotation: 0
        children: []
      # Hidden damage overlay (`B_AvalonC`/`B_LavalonC`): `init()` builds it with
      # `visible = false` and swaps it in when the hull is wrecked.
      - id: gondola-overlay
        type: Sprite2D
        name: Gondola
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/avalon_gondola.png' }
          width: 167
          height: 46
          visible: false
          initiallyVisible: false
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: nose-gun
        type: Group2D
        name: Nose Gun
        properties:
          width: 55
          height: 10
          transform:
            position: [-67, -9]
            scale: [1, 1]
            rotation: 0
        children:
          - id: nose-gun-barrel
            type: Sprite2D
            name: Gun
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/big_gun1.png' }
              width: 55
              height: 10
              transform:
                position: [-27, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: nose-gun-flash
            type: Sprite2D
            name: Muzzle Flash
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/sfx/blowglow.png' }
              width: 16
              height: 16
              opacity: 0
              transform:
                position: [-54, 0]
                scale: [1, 1]
                rotation: 0
            children: []
