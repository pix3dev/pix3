          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: ''
          spritePath: 'res://src/assets/textures/enemy/air/typical_bloon/SU_typical.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "SUC Stones · unused in campaign"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 35]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: carried-mine
        type: Sprite2D
        name: Carried Mine
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/stoneb.png' }
          width: 13
          height: 25
          transform:
            position: [-17.5, -19.5]
            scale: [1, 1]
            rotation: 0
        components:
          - id: carried-mine-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 13
              height: 13
              offsetX: 0
              offsetY: -6.5
              group: enemy
              debugDraw: false
        children: []
      - id: bomb-2
        type: Sprite2D
        name: Bomb 2
