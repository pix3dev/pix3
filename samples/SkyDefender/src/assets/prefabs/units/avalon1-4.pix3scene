          label: "Avalon 1 Fire · unused in campaign"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 39]
            scale: [1, 1]
            rotation: 0
        children: []
      # Hidden damage overlay (`B_AvalonC`/`B_LavalonC`): `init()` builds it with
      # `visible = false` and swaps it in when the hull is wrecked.
      - id: gondola-overlay
