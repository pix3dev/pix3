# Avalon 1 Fire — enemy air unit, id 8 (`Avalon1_4`): three BURNING stone bombs (`Stoneb` + `Burn1` + `Littlebg`).
# Rig transcribed verbatim from the decompiled `com.enemy.Avalon1_4.init()`
# (session export of design/noAds.swf):
#
#   Stoneb  /Littlebg/Burn1: centres (-45,+21) / (-45,+26) / origin (-29,+26)
#   Stoneb a/Littlebg/Burn1: centres (-8, +25) / (-8, +30) / origin (+8, +30)
#   Stoneb b/Littlebg/Burn1: centres (+29,+21) / (+29,+26) / origin (+45,+26)
#   (each Burn1 is `y += 26|30; x = bomb + 16; rotation = 90`)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Avalon 1 Fire (unit prefab, Avalon1_4)"
root:
  - id: unit
    type: Sprite2D
    name: Avalon 1 Fire
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/avalon1/avalon1.png' }
      width: 167
      height: 46
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
