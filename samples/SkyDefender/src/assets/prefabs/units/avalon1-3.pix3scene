# Avalon 1 Mines — enemy air unit, id 7 (`Avalon1_3`): three-`Mine` rack, no gun.
# Rig transcribed verbatim from the decompiled `com.enemy.Avalon1_3.init()`
# (session export of design/noAds.swf):
#
#   Mine  : x -= (w>>1)+45;  y -= (h>>1)-20;  -> centre (-45, +20)
#   Mine a: x -= (w>>1)+8;   y -= (h>>1)-24;  -> centre (-8, +24)
#   Mine b: x -= (w>>1)-29;  y -= (h>>1)-20;  -> centre (+29, +20)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -5)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 5))
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Avalon 1 Mines (unit prefab, Avalon1_3)"
root:
  - id: unit
    type: Sprite2D
    name: Avalon 1 Mines
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/avalon1/avalon1.png' }
      width: 167
      height: 46
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 161
          height: 42
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
