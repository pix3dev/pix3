          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: ''
          spritePath: 'res://src/assets/textures/enemy/air/avalon1/avalon1.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "Avalon 1 Mines · unused in campaign"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 39]
            scale: [1, 1]
            rotation: 0
        children: []
      # Hidden damage overlay (`B_AvalonC`/`B_LavalonC`): `init()` builds it with
      # `visible = false` and swaps it in when the hull is wrecked.
      - id: gondola-overlay
        type: Sprite2D
        name: Gondola
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/avalon_gondola.png' }
          width: 167
          height: 46
          visible: false
          initiallyVisible: false
          transform:
