# NZ Sniper — enemy air unit, id 22 (`NZ_2`): SNIPER zeppelin: the 55x10 `B_TypSnp` barrel, `rld_max 70`.
# Rig transcribed verbatim from the decompiled `com.enemy.NZ_2.init()`
# (session export of design/noAds.swf):
#
#   B_Korzina: x -= w>>1;  y -= (h>>1)-14;  -> centre (0, +14)
#   TypGunMob: x = -12;  y = 21;  tip = 3;  grad = 1;  rld_max = 70
#     B_TypSnp: x = 30;  y = -4;  scaleX = -1
#   B_NZ     : x -= w>>1;  y -= (h>>1)+7;   -> centre (0, -7)
#
# Offsets are Flash (y-DOWN) relative to the UNIT ORIGIN; bitmaps are placed by
# their TOP-LEFT and then centred, so the lines above resolve each to a CENTRE.
# This prefab's ROOT is the body sprite (Flash centre (0, -7)), so every
# child below is rebased onto that centre and flipped to pix3 y-up:
#   pix3 = (fx, -(fy + 7))
# The barrel is drawn UNFLIPPED (`scale: [1, 1]`) in the 180-degree aim pose —
# see the `TypGunMob` note in scripts/gen-levels.mjs for why `mobTG.scaleX = -1`
# belongs to the aim frame and not to the art.
#
# Per-id stats (hp/speed/score/attack) are applied by WaveSpawner from SdBalance.
# GENERATED by scripts/gen-levels.mjs — edit the rig table there, not this file.
version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "NZ Sniper (unit prefab, NZ_2)"
root:
  - id: unit
    type: Sprite2D
    name: NZ Sniper
    properties:
      texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/typical_bloon/Nazi_typical.png' }
      width: 66
      height: 38
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      - id: unit-hitbox
        type: core:Hitbox2D
        enabled: true
        config:
          shape: rect
          width: 60
          height: 34
          offsetX: 0
          offsetY: 0
          group: enemy
          debugDraw: false
      - id: unit-logic
        type: user:EnemyBalloon
        enabled: true
        config:
          hp: 100
          speed: 50
          score: 8
          castleDamage: 0
          stopX: 0
          linkHp: 25
          mineHp: 25
          bomber: false
          gunType: 'heavy'
          spritePath: 'res://src/assets/textures/enemy/air/typical_bloon/Nazi_typical.png'
    children:
      - id: dev-label
        type: Label2D
        name: Dev Label
        properties:
          editorOnly: true
          label: "NZ Sniper · L6,7,9,17,19,24,25,26"
          labelFontSize: 12
          labelColor: "#ffd75e"
          labelAlign: center
          transform:
            position: [0, 35]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: weapon-mount
        type: Sprite2D
        name: Weapon Mount
        properties:
          texture: { type: 'texture', url: 'res://src/assets/textures/enemy/air/gondola/korzina.png' }
          width: 20
          height: 13
          transform:
            position: [0, -21]
            scale: [1, 1]
            rotation: 0
        components:
          - id: weapon-mount-hitbox
            type: core:Hitbox2D
            enabled: true
            config:
              shape: rect
              width: 20
              height: 14
              offsetX: 0
              offsetY: 0
              group: enemy
              debugDraw: false
        children: []
      - id: mount-a
        type: Group2D
        name: Mount A
        properties:
          width: 55
          height: 10
          transform:
            position: [-12, -28]
            scale: [1, 1]
            rotation: 0
        children:
          - id: mount-a-barrel
            type: Sprite2D
            name: Gun
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/enemy/weapons/big_gun1.png' }
              width: 55
              height: 10
              transform:
                position: [-2.5, 1]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: mount-a-flash
            type: Sprite2D
            name: Muzzle Flash
            properties:
              texture: { type: 'texture', url: 'res://src/assets/textures/sfx/blowglow.png' }
              width: 16
              height: 16
              opacity: 0
              transform:
                position: [-30, 1]
                scale: [1, 1]
                rotation: 0
            children: []
