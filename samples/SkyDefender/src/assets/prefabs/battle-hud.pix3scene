version: 1.0.0
metadata:
  author: Sky Defender Remaster
  description: "Battle HUD (reusable chrome)"
root:
  - id: hud
    type: CanvasLayer2D
    name: HUD
    properties:
      width: 1920
      height: 1080
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    children:
      - id: top-hp
        type: Group2D
        name: Top HP
        properties:
          width: 524
          height: 56
          transform:
            position: [0, 505]
            scale: [1, 1]
            rotation: 0
        children:
          - id: hp-fill
            type: Bar2D
            name: HP Fill
            properties:
              label: ""
              width: 452
              height: 30
              minValue: 0
              maxValue: 1
              value: 1
              backBackgroundColor: "#2a1414"
              barColor: "#d43333"
              showBorder: false
              borderColor: "#000000"
              borderWidth: 2
              transform:
                position: [-26, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: hp-frame
            type: Sprite2D
            name: HP Frame
            properties:
              texture:
                type: texture
                url: res://src/assets/textures/gui/ingame/health.png
              width: 524
              height: 56
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: hp-label
            type: Label2D
            name: HP Label
            properties:
              label: 700/700
              labelFontSize: 24
              labelColor: "#f5e6c8"
              labelAlign: center
              transform:
                position: [-26, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: hp-off
            type: Sprite2D
            name: HP Off Cover
            properties:
              texture:
                type: texture
                url: res://src/assets/textures/gui/ingame/health_off.png
              width: 524
              height: 56
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: lives-label
            type: Label2D
            name: Lives Label
            properties:
              label: ""
              labelFontSize: 22
              labelColor: "#ffe27a"
              labelAlign: center
              initiallyVisible: false
              transform:
                position: [152, 9]
                scale: [1, 1]
                rotation: 0
      - id: boss-bar
        type: Group2D
        name: Boss Bar
        properties:
          width: 472
          height: 68
          initiallyVisible: false
          transform:
            position: [0, 432]
            scale: [1, 1]
            rotation: 0
        children:
          - id: boss-hp-fill
            type: Bar2D
            name: Boss HP Fill
            properties:
              label: ""
              width: 400
              height: 16
              minValue: 0
              maxValue: 1
              value: 1
              backBackgroundColor: "#2a1408"
              barColor: "#e8721f"
              showBorder: false
              borderColor: "#000000"
              borderWidth: 2
              transform:
                position: [-8, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: boss-hp-frame
            type: Sprite2D
            name: Boss HP Frame
            properties:
              texture:
                type: texture
                url: res://src/assets/textures/gui/ingame/boss_statusbar.png
              width: 472
              height: 34
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: boss-name-label
            type: Label2D
            name: Boss Name Label
            properties:
              label: ""
              labelFontSize: 22
              labelColor: "#ffd9a8"
              labelAlign: center
              transform:
                position: [0, 26]
                scale: [1, 1]
                rotation: 0
            children: []
      - id: portrait-cluster
