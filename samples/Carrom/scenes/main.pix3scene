                  width: 12
                  height: 12
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: guide-dot-10
                type: Sprite2D
                name: Dot10
                properties:
                  texture:
                    type: texture
                    url: res://sprites/dot.png
                  width: 12
                  height: 12
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: guide-dot-11
                type: Sprite2D
                name: Dot11
                properties:
                  texture:
                    type: texture
                    url: res://sprites/dot.png
                  width: 12
                  height: 12
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: guide-band
                type: ColorRect2D
                name: RubberBand
                properties:
                  width: 6
                  height: 100
                  color: "#f43f5e"
                  opacity: 0.7
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: guide-ghost
                type: Sprite2D
                name: Ghost
                properties:
                  texture:
                    type: texture
                    url: res://sprites/striker_ring.png
                  width: 52
                  height: 52
                  opacity: 0.4
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
              - id: guide-deflect
                type: ColorRect2D
                name: Deflect
                properties:
                  width: 4
                  height: 80
                  color: "#ffffff"
                  opacity: 0.6
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
  - id: hud-root
    type: CanvasLayer2D
    name: HUD
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    children:
      - id: hud-top-panel
        type: ColorRect2D
        name: TopPanel
        properties:
          width: 1080
          height: 300
          color: "#14100d"
          opacity: 0.85
          transform:
            position: [0, 810]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-opponent-name
        type: Label2D
        name: OpponentName
        properties:
          label: "OPPONENT · BLACK"
          labelFontSize: 40
          labelColor: "#cfc6b8"
          labelAlign: center
          transform:
            position: [-270, 870]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-opponent-left
        type: Label2D
        name: OpponentLeft
        properties:
          label: "9 left"
          labelFontSize: 64
          labelColor: "#ffffff"
          labelAlign: center
          transform:
            position: [-270, 800]
            scale: [1, 1]
            rotation: 0
        components:
          - id: hud-opponent-left-punch
            type: core:PunchScale
            enabled: true
            config:
              amount: 0.3
              duration: 0.35
              vibrato: 3
              triggerEvent: bump
              playOnStart: false
        children: []
      - id: hud-player-name
        type: Label2D
        name: PlayerName
        properties:
          label: "YOU · WHITE"
          labelFontSize: 40
          labelColor: "#cfc6b8"
          labelAlign: center
          transform:
            position: [270, 870]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-player-left
        type: Label2D
        name: PlayerLeft
        properties:
          label: "9 left"
          labelFontSize: 64
          labelColor: "#ffffff"
          labelAlign: center
          transform:
            position: [270, 800]
            scale: [1, 1]
            rotation: 0
        components:
          - id: hud-player-left-punch
            type: core:PunchScale
            enabled: true
            config:
              amount: 0.3
              duration: 0.35
              vibrato: 3
              triggerEvent: bump
              playOnStart: false
        children: []
      - id: hud-queen-status
        type: Label2D
        name: QueenStatus
        properties:
          label: "Queen: on board"
          labelFontSize: 34
          labelColor: "#f5ae39"
          labelAlign: center
          transform:
            position: [0, 720]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-turn-banner
        type: Label2D
        name: TurnBanner
        properties:
          label: "YOUR TURN"
          labelFontSize: 72
          labelColor: "#ffffff"
          labelAlign: center
          glowColor: "#f5ae39"
          glowStrength: 2
          transform:
            position: [0, 610]
            scale: [1, 1]
            rotation: 0
        components:
          - id: hud-turn-banner-popin
            type: core:PopIn
            enabled: true
            config:
              from: 0
              duration: 0.4
              easing: backOut
              triggerEvent: show
              playOnStart: false
        children: []
      - id: hud-toast
        type: Label2D
        name: Toast
        properties:
          label: ""
          labelFontSize: 40
          labelColor: "#ff6a5a"
          labelAlign: center
          outlineColor: "#000000"
          outlineWidth: 3
          transform:
            position: [0, -600]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-power-bar
        type: Bar2D
        name: PowerBar
        properties:
          width: 600
          height: 22
          value: 0
          minValue: 0
          maxValue: 1
          barColor: "#f43f5e"
          backBackgroundColor: "#2a2320"
          visible: false
          transform:
            position: [0, -680]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-help
        type: Label2D
        name: HelpLabel
        properties:
          label: "Drag the striker to place it · pull back anywhere to aim · release to shoot"
          labelFontSize: 28
          labelColor: "#9a8f82"
          labelAlign: center
          transform:
            position: [0, -740]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hud-restart-button
        type: Button2D
        name: RestartButton
        properties:
          width: 300
          height: 90
          backgroundColor: "#3b2d24"
          hoverColor: "#4a3a2f"
          pressedColor: "#2b1f18"
          transform:
            position: [0, -850]
            scale: [1, 1]
            rotation: 0
        children:
          - id: hud-restart-label
            type: Label2D
            name: RestartLabel
            properties:
              label: "Restart"
              labelFontSize: 40
              labelColor: "#ffffff"
              labelAlign: center
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
      - id: hud-end-overlay
        type: Group2D
        name: EndOverlay
        properties:
          width: 1080
          height: 1920
          visible: false
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children:
          - id: end-dim
            type: ColorRect2D
            name: Dim
            properties:
              width: 1080
              height: 1920
              color: "#000000"
              opacity: 0.6
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: end-panel
            type: ColorRect2D
            name: Panel
            properties:
              width: 820
              height: 560
              color: "#1b1410"
              opacity: 0.95
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            components:
              - id: end-panel-popin
                type: core:PopIn
                enabled: true
                config:
                  from: 0
                  duration: 0.4
                  easing: backOut
                  triggerEvent: show
                  playOnStart: true
            children: []
          - id: end-result-label
            type: Label2D
            name: ResultLabel
            properties:
              label: "YOU WIN"
              labelFontSize: 96
              labelColor: "#ffffff"
              labelAlign: center
              glowColor: "#f5ae39"
              glowStrength: 2
              transform:
                position: [0, 140]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: end-score-label
            type: Label2D
            name: ScoreLabel
            properties:
              label: "Score 0"
              labelFontSize: 48
              labelColor: "#cfc6b8"
              labelAlign: center
              transform:
                position: [0, 20]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: end-play-again-button
            type: Button2D
            name: PlayAgainButton
            properties:
              width: 360
              height: 110
              backgroundColor: "#3b2d24"
              hoverColor: "#4a3a2f"
              pressedColor: "#2b1f18"
              transform:
                position: [0, -150]
                scale: [1, 1]
                rotation: 0
            children:
              - id: end-play-again-label
                type: Label2D
                name: PlayAgainLabel
                properties:
                  label: "Play again"
                  labelFontSize: 44
                  labelColor: "#ffffff"
                  labelAlign: center
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
