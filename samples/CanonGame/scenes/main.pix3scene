version: 1.0.0
metadata:
  author: Pix3 Agent
  description: Physics-smash prototype (custom box physics)
root:
  - id: game-root
    type: Node3D
    name: Game Root
    properties:
      transform:
        position: [0, 0, 0]
        rotationEuler: [0, 0, 0]
        scale: [1, 1, 1]
    components:
      - id: game-root-user:GameController-1788045145215
        type: user:GameController
        enabled: true
    children:
      - id: main-camera
        type: Camera3D
        name: Main Camera
        properties:
          projection: perspective
          fov: 55
          near: 0.1
          far: 1000
          transform:
            position: [0, 4, -8]
            rotationEuler: [0, 180, 0]
            scale: [1, 1, 1]
        children: []
      - id: key-light
        type: DirectionalLightNode
        name: Key Light
        properties:
          intensity: 1.2
          color: "#ffffff"
          initiallyVisible: true
          visible: true
          transform:
            position: [5, 8, 3]
            rotationEuler: [-45, 35, 0]
            scale: [1, 1, 1]
          castShadow: true
          shadowCameraSize: 20
          shadowMapSize: 2048
        children: []
      - id: ambient-light
        type: AmbientLightNode
