  - id: hud-root
    type: Group2D
    name: HUD Root
    properties:
      width: 1080
      height: 1920
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
      initiallyVisible: true
      visible: true
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    children:
      - id: shots-label
        type: Label2D
        name: ShotsLabel
        properties:
          label: "Выстрелы: 5"
          labelFontSize: 52
          labelColor: "#ffffff"
          labelAlign: left
          outlineColor: "#000000"
          outlineWidth: 3
          layout:
            enabled: true
            horizontalAlign: right
            verticalAlign: top
          transform:
            position: [324.13801522090523, 842.0689655172413]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: kings-label
        type: Label2D
        name: KingsLabel
        properties:
          label: "Короли: 1"
          labelFontSize: 52
          labelColor: "#ff6a5a"
          labelAlign: right
          outlineColor: "#000000"
          outlineWidth: 3
          layout:
            enabled: true
            horizontalAlign: left
            verticalAlign: top
          transform:
            position: [-362.7586206896551, 844.827670393319]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: hint-label
        type: Label2D
        name: HintLabel
        properties:
          label: Тапни, чтобы выстрелить
          labelFontSize: 40
          labelColor: "#ffffff"
          labelAlign: center
          outlineColor: "#000000"
          outlineWidth: 3
          layout:
            enabled: true
            horizontalAlign: center
            verticalAlign: bottom
          transform:
            position: [0, 120]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: result-overlay
        type: Group2D
        name: ResultOverlay
        properties:
          visible: false
          width: 1080
          height: 1920
          layout:
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children:
          - id: result-panel
            type: ColorRect2D
            name: ResultPanel
            properties:
              color: "#101018"
              opacity: 0.72
              width: 820
              height: 620
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: center
              transform:
                position: [0, 0]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: result-label
            type: Label2D
            name: ResultLabel
            properties:
              label: Победа!
              labelFontSize: 96
              labelColor: "#ffffff"
              labelAlign: center
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: center
              transform:
                position: [0, -160]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: stars-label
            type: Label2D
            name: StarsLabel
            properties:
              label: ★★★
              labelFontSize: 80
              labelColor: "#ffd23f"
              labelAlign: center
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: center
              transform:
                position: [0, -30]
                scale: [1, 1]
                rotation: 0
            children: []
          - id: retry-button
            type: Button2D
            name: RetryButton
            properties:
              width: 360
              height: 120
              backgroundColor: "#c0453b"
              hoverColor: "#d4564b"
              pressedColor: "#a03a32"
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: center
              transform:
                position: [0, 130]
                scale: [1, 1]
                rotation: 0
              buttonAction: Submit
            children:
              - id: retry-label
                type: Label2D
                name: RetryLabel
                properties:
                  label: Ещё раз
                  labelFontSize: 48
                  labelColor: "#ffffff"
                  labelAlign: center
                  transform:
                    position: [0, 0]
                    scale: [1, 1]
                    rotation: 0
                children: []
          - id: next-button
            type: Button2D
            name: NextButton
            properties:
              width: 360
              height: 120
              backgroundColor: "#3a7d44"
              hoverColor: "#469153"
              pressedColor: "#2f6839"
              layout:
                enabled: true
                horizontalAlign: center
                verticalAlign: center
              transform:
                position: [0, 270]
                scale: [1, 1]
                rotation: 0
              buttonAction: Submit
            children:
              - id: next-label
                type: Label2D
                name: NextLabel
                properties:
                  label: Дальше
                  labelFontSize: 48
