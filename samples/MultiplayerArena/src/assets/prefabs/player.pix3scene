version: 1.0.0
metadata:
  author: Pix3 Multiplayer Arena
  description: >-
    One player's avatar. This prefab is the only spawnable kind in the project, so its wire Kind is
    0. The owner instantiates it locally and core:NetworkedNode mints the entity; every peer's
    NetworkNodeBinder instantiates this same file when that entity enters its AOI.
root:
  - id: player-root
    type: Group2D
    name: Player
    properties:
      width: 64
      height: 64
      transform:
        position: [0, 0]
        scale: [1, 1]
        rotation: 0
    components:
      # spawnOnStart is deliberately ON: components start a tick after instantiate(), which is when
      # ArenaController has already placed the node on its spawn point, so the entity is minted at
      # the right position instead of at the prefab's origin.
      - id: net-node
        type: core:NetworkedNode
        enabled: true
        config:
          prefabPath: res://src/assets/prefabs/player.pix3scene
          ownership: owned
          spawnOnStart: true
          despawnOnDetach: true
          appFlags: 0
      - id: net-transform
        type: core:ReplicatedTransform
        enabled: true
        config:
          sendRateHz: 20
          replicateRotation: false
          interpolationDelayMs: 0
          plane: xy
      - id: avatar
        type: user:PlayerAvatar
        enabled: true
        config:
          moveSpeed: 420
          boundsX: 760
          boundsY: 410
    children:
      # Drawn first, so it sits *under* the body — the "it" halo.
      - id: it-ring
        type: ColorRect2D
        name: It Ring
        properties:
          width: 92
          height: 92
          color: "#ffcf33"
          opacity: 0.9
          initiallyVisible: false
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: body
        type: ColorRect2D
        name: Body
        properties:
          width: 64
          height: 64
          color: "#4ea1ff"
          transform:
            position: [0, 0]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: nose
        type: ColorRect2D
        name: Nose
        properties:
          width: 18
          height: 18
          color: "#0d1117"
          transform:
            position: [0, 22]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: name-label
        type: Label2D
        name: Name
        properties:
          label: "player"
          labelFontSize: 20
          labelColor: "#e8eef7"
          labelAlign: center
          transform:
            position: [0, 56]
            scale: [1, 1]
            rotation: 0
        children: []
      - id: emote-label
        type: Label2D
        name: Emote
        properties:
          label: ""
          labelFontSize: 26
          labelColor: "#ffcf33"
          labelAlign: center
          initiallyVisible: false
          transform:
            position: [0, 90]
            scale: [1, 1]
            rotation: 0
        children: []
