{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    /* Set semantics, NOT define: Lit's `@property` decorators need it, and every editor
       component is a Lit element. `packages/pix3-runtime/tsconfig.json` deliberately says
       `true` — it type-checks the runtime the way CONSUMERS compile it (the package ships
       TS sources, and `target: ES2022` alone turns define semantics on). The divergence is
       intentional and neither side can adopt the other; the hazard it creates — a subclass
       field declaration shadowing a base accessor — is handled inside
       `fw/reactive-schema-properties.ts`, which repairs it on the subclass's install. */
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "vitest"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "rootDir": ".",
    /* Path mapping */
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/services/*": [
        "./src/services/*"
      ],
      "@/state/*": [
        "./src/state/*"
      ],
      "@/fw/*": [
        "./src/fw/*"
      ],
      "@pix3/runtime": [
        "./packages/pix3-runtime/src"
      ],
      "@pix3/runtime/*": [
        "./packages/pix3-runtime/src/*"
      ]
    },
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src",
    "packages/pix3-runtime/src"
  ],
  "exclude": [
    "samples",
    "src/templates/projects/*/files"
  ]
}